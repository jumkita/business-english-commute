# このファイルを .streamlit/secrets.toml にコピーして値を書き換える（secrets.toml は Git に含めない）。
# Streamlit Community Cloud では、アプリの Settings → Secrets に同じ内容を貼り付ける。

# 学習履歴を保存するためのパスコード（自分で決めた推測されにくい文字列）
APP_PASSCODE = "change-me"

# 学習履歴を保存する非公開（secret）Gist の ID。Gist の URL の末尾にある英数字
GIST_ID = "0123456789abcdef0123456789abcdef"

# Gist の読み書きだけを許可した GitHub のトークン（Fine-grained token の Account permissions → Gists: Read and write）
GITHUB_TOKEN = "github_pat_xxxxxxxx"

# ローカルで Gist を使わずにファイルへ保存する場合は、上の GIST_ID と GITHUB_TOKEN を消してこちらを使う
# PROGRESS_FILE = "progress.local.json"
